# PolicyVault configuration — copy to .env and fill in ONLY for testnet mode.
# The demo and the test suite need none of this (deterministic local simulation).

# Transport mode: "sim" (default, local simulation, no network, no keys)
# or "testnet" (real NEAR testnet via near-api-js).
MODE=sim

# --- Testnet mode only -------------------------------------------------------
# A testnet account YOU created in a NEAR wallet (e.g. via wallet.near.org /
# MyNearWallet testnet) and funded from the standard testnet faucet.
# Prefer a FUNCTION-CALL access key limited to the contracts/methods your
# policy allows, instead of a full-access key, if you hold real value.
NEAR_ACCOUNT_ID=your-agent.testnet
NEAR_PRIVATE_KEY=ed25519:REPLACE_WITH_YOUR_OWN_TESTNET_KEY
NEAR_NODE_URL=https://rpc.testnet.near.org

# --- Optional ----------------------------------------------------------------
# Policy file (JSON, amounts in NEAR decimal strings). Defaults to the
# built-in demo policy when unset.
POLICY_FILE=./policy.example.json
# Append-only audit log file for send.ts. Defaults to ./audit.log.jsonl
AUDIT_FILE=./audit.log.jsonl
# Opening balance for the simulated wallet, in NEAR. Default 10.
SIM_BALANCE_NEAR=10
